<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/Emby.Sso/Protocol/**/*.cs" LinkBase="Protocol" />
  </ItemGroup>

  <!-- The configuration page as it is actually shipped. Nothing compiles HTML
       or JavaScript, so the only way a mistake in them is caught before an
       operator finds it is a test that reads the real files - not a copy, which
       would drift. Embedded rather than copied to the output directory so the
       test cannot pass against a stale build. -->
  <ItemGroup>
    <EmbeddedResource Include="../../src/Emby.Sso/Configuration/configPage.html" LogicalName="configPage.html" />
    <EmbeddedResource Include="../../src/Emby.Sso/Configuration/configPage.js" LogicalName="configPage.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
