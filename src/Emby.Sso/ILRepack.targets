<Project>
  <Target Name="MergeDependencies" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <MergeInput Include="$(OutputPath)$(AssemblyName).dll" />
      <MergeInput Include="$(OutputPath)Microsoft.IdentityModel.*.dll" />
      <MergeInput Include="$(OutputPath)Newtonsoft.Json.dll" />
      <MergeInput Include="$(OutputPath)System.IdentityModel.Tokens.Jwt.dll" />
      <!-- Everything below is a netstandard2.0 dependency that
           Microsoft.IdentityModel 8 reaches for and the 6.35.0 build did not,
           and that the .NET runtime Emby is built on does not carry:
           Microsoft.Bcl.TimeProvider (the TimeProvider backport) and the
           Microsoft.Bcl.AsyncInterfaces it needs, Microsoft.Extensions.Logging
           .Abstractions, and - from 8.19 onwards - Microsoft.Bcl.Cryptography
           together with the System.Formats.Asn1 version IT needs, which is
           newer than the runtime's and so cannot bind to it.

           They are merged rather than shipped alongside because the plugin is
           installed as ONE file (see the README). Left unmerged they would
           become external references the merged assembly cannot resolve unless
           the server happens to carry each one, which is not something this
           repository can check - the failure would be a plugin that silently
           does not load. Merged, the shipped DLL's external references stay
           inside the set the proven 6.35.0 build already needed plus assemblies
           that are part of the .NET runtime itself.

           If a future upgrade adds another dependency, the check that matters
           is the merged assembly's own reference list, not this comment. -->
      <MergeInput Include="$(OutputPath)Microsoft.Bcl.TimeProvider.dll" />
      <MergeInput Include="$(OutputPath)Microsoft.Bcl.AsyncInterfaces.dll" />
      <MergeInput Include="$(OutputPath)Microsoft.Extensions.Logging.Abstractions.dll" />
      <MergeInput Include="$(OutputPath)Microsoft.Bcl.Cryptography.dll" />
      <MergeInput Include="$(OutputPath)System.Formats.Asn1.dll" />
      <MergeLibDir Include="$(OutputPath)" />
      <MergeLibDir Include="@(ReferencePath->'%(RootDir)%(Directory)'->Distinct())" />
    </ItemGroup>
    <!-- Internalize is not unconditional: ILRepack leaves a merged type PUBLIC
         when internalizing it would break a public signature of the primary
         assembly. So the plugin's own public surface decides how much of the
         merged library surface escapes. Until this was noticed the plugin
         exported 13 Microsoft.IdentityModel types (OpenIdConnectConfiguration,
         JsonWebKey, SecurityKey, CryptoProviderFactory and friends) purely
         because OidcClient and SsoRuntime were public and named them.

         Everything except what Emby itself has to resolve - Plugin, the
         configuration class, the authentication provider, the service and its
         two route request types - is therefore internal, and must stay that
         way. Making one Emby.Sso type public can quietly make a dozen library
         types public with it; the check is the merged assembly's exported-type
         list, which should contain nothing outside the Emby.Sso namespace. -->
    <ILRepack
      Parallel="true"
      Internalize="true"
      InputAssemblies="@(MergeInput->'%(FullPath)')"
      LibraryPath="@(MergeLibDir)"
      TargetKind="Dll"
      OutputFile="$(OutputPath)merged/$(AssemblyName).dll" />
  </Target>
</Project>
