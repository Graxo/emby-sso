.superpowers/
bin/
obj/
*.user
.dotnet/
artifacts/

# CI build staging and NuGet package cache
dist/
.nuget/

# Licence signing keys. The issuing tool refuses to write one inside a git
# working tree at all (tools/Emby.Sso.LicenceTool/README.md); this is the
# second line of defence, because a private key that reaches a commit has to
# be treated as leaked and every licence issued with it reissued.
licence-signing-key.private.json
*.private.json
*.pem
*.p12
*.pfx

# The issuing tool's ledger of who was given a licence for which server. It is
# a record of credentials, so it follows the private key's rule: the tool
# refuses to write it inside a git working tree, and this is the second line of
# defence. It lives beside the signing key, outside any repository.
licences-issued.jsonl
