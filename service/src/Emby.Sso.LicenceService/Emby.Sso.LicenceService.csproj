<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The vendor's licence and purchase service. It is NOT part of the plugin
       and must never become part of it: nothing in src/ references this, and it
       is deliberately not in Emby.Sso.sln, so `dotnet build` at the repository
       root - which is what CI runs - does not build or ship any of it. It has
       its own solution, service/Emby.Sso.Service.sln. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Emby.Sso.LicenceService</RootNamespace>
    <AssemblyName>Emby.Sso.LicenceService</AssemblyName>
    <!-- The test project drives the endpoints in-process through
         WebApplicationFactory, which needs the entry point to be visible. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Emby.Sso.Licensing/Emby.Sso.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The whole store. See README.md, "Why SQLite". -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />

    <!-- The native SQLite engine, pinned FORWARD of what Microsoft.Data.Sqlite
         8.0.10 asks for.
         
         That package still resolves SQLitePCLRaw 2.1.6, which carries a High
         advisory (GHSA-2m69-gcr7-jv3q) against the SQLite build inside it. The
         advisory is real for us: this is the engine the licence store runs on.
         Naming the package directly here promotes it over the transitive
         resolution, which is the supported way to move a dependency you do not
         reference yourself.

         ci/audit-packages.sh is what found it, and is what will find the next
         one - it fails the pipeline rather than printing a warning, because the
         plugin ships as one merged DLL and the service as one image, so nobody
         downstream can patch a dependency without a new build from here. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />

    <!-- SMTP. Chosen over System.Net.Mail.SmtpClient, which Microsoft's own
         documentation marks as not recommended for new development, and which
         cannot do implicit TLS at all: its EnableSsl is STARTTLS only, so a
         465 relay is unreachable through it. MailKit does all three transport
         modes, and its StartTls option FAILS CLOSED when a server does not
         offer STARTTLS rather than quietly continuing in the clear. See
         README.md, "Emailing the code". -->
    <PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Emby.Sso.LicenceService.Tests" />
  </ItemGroup>

</Project>
