<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Emby.Sso.LicenceService.Tests</RootNamespace>
    <AssemblyName>Emby.Sso.LicenceService.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Drives the real routes in-process, so the contract tests exercise the
         same wiring Program.Main builds rather than a copy of it. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Emby.Sso.LicenceService/Emby.Sso.LicenceService.csproj" />
    <ProjectReference Include="../../src/Emby.Sso.Licensing/Emby.Sso.Licensing.csproj" />
  </ItemGroup>

</Project>
